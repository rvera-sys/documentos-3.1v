# ═══════════════════════════════════════════════════════════════
# DOCUMENTOS 3.2 — Variables de Entorno
# ═══════════════════════════════════════════════════════════════

# SUPABASE
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Nunca en el frontend: clave administrativa exclusiva del backend/Vercel.
SUPABASE_SERVICE_ROLE_KEY=eyJ-service-role-example...

# GOOGLE OAUTH2
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# JWT
JWT_SECRET=tu-secret-aleatorio-aqui-cambiar
JWT_EXPIRATION=24h

# ACCESO Y CORS
# Mails autorizados a iniciar sesión, separados por comas.
ADMIN_EMAILS=inmovera2011@gmail.com
# Orígenes frontend permitidos, separados por comas.
ALLOWED_ORIGINS=https://documentos-3-1v.vercel.app
# Activar la validación obligatoria contra email_whitelist.
WHITELIST_MODE=on

# DEPLOYMENT
NODE_ENV=development
